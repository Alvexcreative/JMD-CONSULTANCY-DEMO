---
import Chalk from '../layouts/Chalk.astro';
import PageHead from '../components/chalk/PageHead.astro';
import { intro, systems, taglines } from '../data/content';
import { IMG } from '../data/chalk';
---
<Chalk page="systems" title="Systems" heroImage={`${IMG}/gen/systems-servers.jpg`}
  description="CODA / Unit4 Financials and NetSuite, linked with Microsoft SQL Server or Oracle: the systems JMD Consulting implements and integrates.">

  <PageHead n={2} label="Systems" title={taglines.specialists} image={`${IMG}/gen/systems-servers.jpg`}
    fx="68%" fy="50%" mfx="60%" mfy="60%" lede={intro.specialise} />

  <section class="sec" aria-labelledby="fit-h">
    <div class="wrap">
      <div class="sec__head">
        <p class="mono sec__ref"><b>2.1</b>How they fit</p>
        <div>
          <h2 id="fit-h" data-split>One family of systems</h2>
          {/* first sentence from the live site; the second is bridging copy, for approval */}
          <p class="sec__lede" data-rise>Accounting and finance systems, linked with MS SQL Server&reg; or Oracle&reg;. The integration between them is the work.</p>
        </div>
      </div>
      <div class="indent">
        <div>
          {/* each system can be selected (hover, focus or tap) to trace its
              route through the integration; its line is quoted below */}
          <div class="wire" role="group" aria-labelledby="fit-h" aria-describedby="wire-note">
            <svg class="wire__svg" aria-hidden="true"></svg>
            <div class="wire__row wire__row--top">
              {systems.list.slice(0, 2).map((s) => <button type="button" class="node" data-note={s.note} aria-pressed="false"><span class="mono">Finance system</span><b>{s.name}</b></button>)}
            </div>
            <div class="wire__hub"><button type="button" class="node" data-note={systems.notes[0]} aria-pressed="false"><span class="mono">JMD Consulting</span><b>Systems integration</b></button></div>
            <div class="wire__row wire__row--bot">
              {systems.list.slice(2).map((s) => <button type="button" class="node" data-note={s.note} aria-pressed="false"><span class="mono">Database</span><b>{s.name}</b></button>)}
            </div>
          </div>
          <p class="wire__note" id="wire-note" aria-live="polite"><span class="mono wire__who">Trace a route</span><span class="wire__say">Select a system to see where it connects.</span></p>
          <script src="../scripts/chalk/wire.js"></script>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--tint" aria-labelledby="ledger-h">
    <div class="wrap">
      <div class="sec__head">
        <p class="mono sec__ref"><b>2.2</b>The ledger</p>
        <h2 id="ledger-h" data-split>{systems.heading}</h2>
      </div>
      <div class="indent">
        <div>
          <ol class="ledger" data-rise>
            {systems.list.map((s) => <li><span class="n">{s.n}</span><b>{s.name}</b><span>{s.note}</span></li>)}
          </ol>
          <div class="pair">
            <figure class="ph ph--land" data-reveal>
              <img src={`${IMG}/gen/systems-team.jpg`} alt="Three colleagues reviewing a system diagram on a wall screen." width="1024" height="688" loading="lazy" decoding="async" />
            </figure>
            <figure class="ph ph--tall" data-reveal>
              <img src={`${IMG}/gen/systems-atrium.jpg`} alt="A glass and steel atrium roof seen from below." width="896" height="1120" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="claims-h">
    <div class="wrap">
      <div class="sec__head">
        <p class="mono sec__ref"><b>2.3</b>In practice</p>
        <h2 id="claims-h" data-split>{taglines.evolve}</h2>
      </div>
      <div class="indent">
        <ul class="claims" data-rise>
          {/* the first note opens the page lede above, so it is not repeated here */}
          {systems.notes.slice(1).map((n) => <li class="claim">{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

</Chalk>
