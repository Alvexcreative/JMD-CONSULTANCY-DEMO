---
import L from '../../layouts/Montfort.astro';
import { services, intro, taglines } from '../../data/content';
---
<L title="Services" description={intro.specialise} page="Services">
  <section class="pagehead">
    <div class="wrap">
      <p class="caps">Services</p>
      <h1>{taglines.specialists}</h1>
      <p class="lede">{intro.specialise}</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      {services.map((s) => (
        <article class="svc">
          <div class="svc-n">{s.n}</div>
          <div>
            <h3>{s.title}</h3>
            <p class="body">{s.body}</p>
            <ul>{s.points.map((p) => (<li>{p}</li>))}</ul>
          </div>
        </article>
      ))}
      <div class="btn-row">
        <a class="btn btn--solid" href="/montfort/contact">Discuss a project</a>
        <a class="btn" href="/montfort/systems">Systems we work with</a>
      </div>
    </div>
  </section>
</L>
