---
import L from '../../layouts/Montfort.astro';
import { site, taglines, intro, storyline, services, credentials, statement } from '../../data/content';
---
<L title="Financial Systems & Integration Consulting" description={intro.welcome} page="Home">
  <section class="pagehead">
    <div class="pagehead-media">
      <img src="/assets/heroes/02-genre.jpg" alt="A snow-capped summit breaking through a vast sea of cloud." />
    </div>
    <div class="wrap">
      <p class="caps">{site.strapline}</p>
      <h1>{taglines.moving}.<br />{taglines.evolve}</h1>
      <p class="lede">{intro.welcome}</p>
      <div class="btn-row">
        <a class="btn btn--solid" href="/montfort/services">Our services</a>
        <a class="btn" href="/montfort/contact">Start a conversation</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="grid3">
        {storyline.map((s) => (
          <article class="item">
            <h3 class="caps">{s.title}</h3>
            <p class="body">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap">
      <div class="band-head">
        <h2>{intro.specialise.split('.')[0]}.</h2>
        <p class="lede">Four disciplines, one specialism: the finance systems a business reports from.</p>
      </div>
      <div class="grid2">
        {services.map((s) => (
          <article class="item">
            <h3>{s.title}</h3>
            <p class="body">{s.body}</p>
          </article>
        ))}
      </div>
      <div class="btn-row"><a class="btn" href="/montfort/services">All services in detail</a></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="statement">{statement}</p>
      <p class="caps">{site.name}</p>
      <div class="facts">
        {credentials.items.map((c) => (
          <div class="fact">
            <p class="caps">{c.big}</p>
            <p class="body">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</L>
