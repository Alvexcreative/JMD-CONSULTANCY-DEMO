---
import Chalk from '../../layouts/Chalk.astro';
import PageHead from '../../components/chalk/PageHead.astro';
import { notes, href, IMG } from '../../data/chalk';

export function getStaticPaths() {
  return notes.map((n, i) => ({ params: { slug: n.slug }, props: { i } }));
}
const { i } = Astro.props;
const n = notes[i];
const prev = notes[i - 1], next = notes[i + 1];
---
<Chalk page="notes" title={n.title} heroImage={`${IMG}/${n.image}`} description={n.standfirst}>
  <PageHead n={`5.${i + 1}`} label="Practice note" title={n.title} image={`${IMG}/${n.image}`}
    fx="64%" fy="50%" mfx="60%" mfy="62%" lede={n.standfirst} />

  <article class="article">
    <div class="wrap indent">
      <div>
        <div class="article__body" data-rise>
          {n.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="quote" data-rise>
          <blockquote>{n.quote}</blockquote>
          <figcaption class="mono">JMD Consulting</figcaption>
        </figure>
        <nav class="pn" aria-label="More notes">
          {prev ? <a href={href(`notes/${prev.slug}`)}><span class="mono">Previous note</span><span class="lnk">{prev.title}</span></a> : <a href={href('notes')}><span class="mono">All notes</span><span class="lnk">Notes</span></a>}
          {next ? <a href={href(`notes/${next.slug}`)}><span class="mono">Next note</span><span class="lnk">{next.title}</span></a> : <a href={href('notes')}><span class="mono">All notes</span><span class="lnk">Back to the notes</span></a>}
        </nav>
      </div>
    </div>
  </article>
</Chalk>
