---
import Chalk from '../layouts/Chalk.astro';
import PageHead from '../components/chalk/PageHead.astro';
import { contact, site, taglines } from '../data/content';
import { IMG } from '../data/chalk';
const err = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.4"/><path d="M8 4.8v4M8 11.1v.1"/></svg>';
---
<Chalk page="enquiry" title="Enquiry" heroImage={`${IMG}/gen/enquiry-meeting.jpg`}
  description="Tell JMD Consulting what your finance system is doing. Telephone +44 (0) 1423 884000 or email info@jmdconsulting.co.uk.">

  <PageHead n={4} label="Enquiry" title={taglines.listen} image={`${IMG}/gen/enquiry-meeting.jpg`}
    fx="72%" fy="50%" mfx="76%" mfy="58%" lede={contact.invitation} />

  <section class="enq enq--page" id="enquiry" aria-label="Enquiry">
    <div class="wrap enq__in">
      <div data-rise>
        <p class="enq__lede">{contact.lede}</p>
        <div class="contact enq__facts mono">
          <dl>
            <dt>Telephone</dt><dd><a class="lnk" href={site.phoneHref}>{site.phone}</a></dd>
            <dt>Email</dt><dd><a class="lnk" href={`mailto:${site.email}`}>{site.email}</a></dd>
          </dl>
        </div>
        <figure class="ph" data-reveal>
          <img src={`${IMG}/gen/enquiry-desk.jpg`} alt="A desk by a window with a telephone, an open notebook and a pen." width="896" height="1120" loading="lazy" decoding="async" />
        </figure>
      </div>

      <form data-enquiry novalidate>
        <div class="f2">
          <div class="field" data-field>
            <label for="e-name" class="mono">Name <i aria-hidden="true">*</i></label>
            <input id="e-name" name="name" type="text" autocomplete="name" required />
            <p class="err mono" id="e-name-err"><Fragment set:html={err} />Enter your name</p>
          </div>
          <div class="field" data-field>
            <label for="e-org" class="mono">Organisation <i aria-hidden="true">*</i></label>
            <input id="e-org" name="organisation" type="text" autocomplete="organization" required />
            <p class="err mono" id="e-org-err"><Fragment set:html={err} />Enter your organisation</p>
          </div>
        </div>
        <div class="f2">
          <div class="field" data-field>
            <label for="e-email" class="mono">Email <i aria-hidden="true">*</i></label>
            <input id="e-email" name="email" type="email" autocomplete="email" inputmode="email" required />
            <p class="err mono" id="e-email-err"><Fragment set:html={err} />Enter a valid email address</p>
          </div>
          <div class="field" data-field>
            <label for="e-sys" class="mono">Finance system <i aria-hidden="true">*</i></label>
            <select id="e-sys" name="system" required>
              <option value="">Select&hellip;</option>
              {contact.systems.map((s) => <option>{s}</option>)}
            </select>
            <p class="err mono" id="e-sys-err"><Fragment set:html={err} />Choose a system</p>
          </div>
        </div>
        <div class="field" data-field>
          <label for="e-detail" class="mono">What is happening <i aria-hidden="true">*</i></label>
          <textarea id="e-detail" name="detail" required placeholder="A stalled implementation, a consolidation that will not balance, a report the system will not produce, a migration off a legacy ledger…"></textarea>
          <p class="err mono" id="e-detail-err"><Fragment set:html={err} />Tell us briefly what is happening</p>
        </div>
        <button class="btn btn--send" type="submit" data-magnetic><span class="btn__l">Send enquiry
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></span><svg class="btn__tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 12.6 10 17l8.5-9.5"/></svg>
        </button>
        <p class="enq__note">{contact.demoNotice}</p>
        <div class="sent" role="status">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="tick" d="M2.5 8.4 6.2 12l7.3-8"/></svg>
          <p><b>Enquiry recorded.</b> <span>Nothing has been sent: this form is a demonstration. To reach JMD now, call <a class="lnk" href={site.phoneHref}>{site.phone}</a>.</span></p>
        </div>
      </form>
    </div>
  </section>

</Chalk>
