---
import L from '../../layouts/Growth.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { site, contact, reach, taglines } from '../../data/content';
---
<L title="Contact" description={contact.invitation} page="Contact">
  <section class="pagehead">
    <div class="pagehead-wash"></div>
    <div class="wrap">
      <p class="eyebrow">{taglines.working}</p>
      <h1 style="margin-top:12px">{contact.heading}</h1>
      <p class="lead-xl">{contact.invitation}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="two">
        <div>
          <h2 style="font-size:clamp(1.3rem,2vw,1.8rem)">Enquiry</h2>
          <p class="body" style="margin:14px 0 30px">{contact.lede}</p>
          <EnquiryForm tone="growth" />
        </div>
        <div>
          <div class="cred"><p class="big">Telephone</p><p class="body"><a href={site.phoneHref}>{site.phone}</a></p></div>
          <div class="cred" style="margin-top:26px"><p class="big">Email</p><p class="body"><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
          <div class="cred" style="margin-top:26px"><p class="big">Base</p><p class="body">{reach.facts[1].value}</p></div>
          <div class="cred" style="margin-top:26px"><p class="big">Regions</p><p class="body">{reach.facts[0].value}</p></div>
        </div>
      </div>
    </div>
  </section>
</L>
