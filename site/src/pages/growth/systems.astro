---
import L from '../../layouts/Growth.astro';
import { systems } from '../../data/content';
---
<L title="Systems" description={systems.notes[0]} page="Systems">
  <section class="pagehead">
    <div class="pagehead-wash"></div>
    <div class="wrap">
      <p class="eyebrow">{systems.kicker}</p>
      <h1 style="margin-top:12px">{systems.heading}</h1>
      <p class="lead-xl">{systems.notes[0]}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      {systems.list.map((s) => (
        <article class="sys-row">
          <div class="sys-n">{s.n}</div>
          <div>
            <p class="sys-name">{s.name}</p>
            <p class="body" style="margin-top:6px">{s.note}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="block block--tan">
    <div class="wrap">
      <div class="two">
        <div><h2>Delivered with the tools the business already runs on</h2></div>
        <div>
          {systems.notes.slice(1).map((n) => (<p class="lead" style="margin-bottom:18px">{n}</p>))}
          <div class="btn-row"><a class="btn btn--light" href="/growth/contact">Tell us what you run</a></div>
        </div>
      </div>
    </div>
  </section>
</L>
