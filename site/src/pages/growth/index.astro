---
import L from '../../layouts/Growth.astro';
import { taglines, intro, storyline, services, systems, statement, site } from '../../data/content';
---
<L title="Financial Systems & Integration Consulting" description={intro.welcome} page="Home">
  <section class="pagehead">
    <img class="pagehead-photo" src="/assets/harrogate/harrogate-03.jpg" alt="A wide common with avenues of trees in blossom, backed by honey sandstone terraces and the Yorkshire hills." />
    <div class="pagehead-wash"></div>
    <div class="wrap">
      <h1>{taglines.moving}.<span class="l2">{taglines.evolve}</span></h1>
      <p class="lead-xl">{intro.welcome}</p>
      <div class="btn-row">
        <a class="btn btn--solid" href="/growth/services">See our services</a>
        <a class="btn btn--outline" href="/growth/contact">Schedule a call</a>
      </div>
    </div>
  </section>

  <div class="strip">
    <div class="wrap">
      <p class="strip-label">{systems.kicker}</p>
      <div class="strip-items">{systems.list.map((s) => (<span>{s.name}</span>))}</div>
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="three">
        {storyline.map((s) => (
          <article>
            <div class="rule"></div>
            <h3>{s.title}</h3>
            <p class="body" style="margin-top:12px">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block block--tan">
    <div class="wrap">
      <div class="two">
        <div>
          <p class="eyebrow">Our practice</p>
          <h2 style="margin-top:10px">{taglines.solution}</h2>
        </div>
        <div>
          <blockquote class="statement">{statement}</blockquote>
          <p class="lead" style="margin-top:22px;opacity:.9">— {site.name}</p>
          <div class="btn-row"><a class="btn btn--light" href="/growth/about">About the practice</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="block block--muted">
    <div class="wrap">
      <div class="sec-head">
        <h2>Choose your path</h2>
        <p class="body">Whether you are implementing a new finance system, migrating off a legacy one, or making the reporting you already have tell the truth — there is a route for you.</p>
      </div>
      <div class="three">
        {services.slice(0, 3).map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p class="body" style="flex:1">{s.body}</p>
            <a class="eyebrow" href="/growth/services">Learn more →</a>
          </article>
        ))}
      </div>
      <div class="btn-row"><a class="btn btn--solid" href="/growth/services">All services</a></div>
    </div>
  </section>
</L>
