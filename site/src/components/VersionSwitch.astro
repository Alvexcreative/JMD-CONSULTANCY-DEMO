---
/* Review chrome. Deliberately neutral — not part of either design's
   language — so it reads as a tool laid over the work rather than part
   of it. Links to the SAME page in the other build, so comparison is
   like for like instead of dumping you back on a homepage. */
const path = Astro.url.pathname;
const current = path.startsWith('/growth') ? 'growth' : path.startsWith('/chalk') ? 'chalk' : 'montfort';
const rest = path.replace(/^\/(montfort|growth|chalk)\/?/, '');
const pageName = rest.replace(/\/$/, '').split('/')[0] || 'home';
/* Chalk is a larger site with its own section names: each page maps to
   its nearest equivalent in the other builds, and back */
const toChalk: Record<string, string> = { '': '', services: 'services', systems: 'systems', about: 'reach', contact: 'enquiry' };
const fromChalk: Record<string, string> = { '': '', services: 'services', systems: 'systems', reach: 'about', evidence: 'about', notes: '', enquiry: 'contact' };
const to = (d: string) => {
  if (d === current) return path;
  if (d === 'chalk') return `/chalk/${toChalk[pageName === 'home' ? '' : pageName] ?? ''}`.replace(/([^/])$/, '$1/');
  const slug = current === 'chalk' ? (fromChalk[pageName === 'home' ? '' : pageName] ?? '') : (pageName === 'home' ? '' : pageName);
  return `/${d}/${slug}`.replace(/([^/])$/, '$1/');
};
const builds = [
  { id: 'chalk', name: 'Chalk' },
  { id: 'montfort', name: 'Montfort' },
  { id: 'growth', name: 'Path for Growth' },
];
---
<nav class="vswitch" aria-label="Compare design versions">
  <span class="vswitch-label">{pageName}</span>
  <span class="vswitch-sep" aria-hidden="true"></span>
  {builds.map((b) => (
    <a
      href={to(b.id)}
      aria-current={b.id === current ? 'true' : undefined}
      title={`See ${pageName} in the ${b.name} build`}
    >{b.name}</a>
  ))}
  <span class="vswitch-sep" aria-hidden="true"></span>
  <a href="/" title="All builds">Index</a>
</nav>

<style is:global>
  .vswitch {
    position: fixed; z-index: 9999;
    left: 50%; bottom: 18px; transform: translateX(-50%);
    display: flex; align-items: center; gap: 3px;
    padding: 5px;
    max-width: calc(100vw - 24px);
    background: rgba(14, 14, 16, .84);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 999px;
    box-shadow: 0 8px 32px -8px rgba(0, 0, 0, .55);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    font-family: ui-sans-serif, -apple-system, "Segoe UI", system-ui, sans-serif;
    font-size: 12px; font-weight: 500; letter-spacing: 0;
    transition: opacity .3s ease, transform .3s ease;
  }
  .vswitch[data-tucked="true"] { opacity: .16; transform: translateX(-50%) translateY(12px); }
  .vswitch[data-tucked="true"]:hover { opacity: 1; transform: translateX(-50%); }
  .vswitch a {
    display: inline-flex; align-items: center;
    min-height: 44px; padding: 0 15px;
    border-radius: 999px; white-space: nowrap;
    color: rgba(255, 255, 255, .56); text-decoration: none;
    transition: background .18s ease, color .18s ease;
  }
  .vswitch a:hover { background: rgba(255, 255, 255, .09); color: rgba(255, 255, 255, .94); }
  .vswitch a[aria-current="true"] { background: rgba(255, 255, 255, .15); color: #fff; }
  .vswitch a:focus-visible { outline: 2px solid #7DA7FF; outline-offset: 2px; }
  .vswitch-label {
    padding: 0 6px 0 12px; color: rgba(255, 255, 255, .38);
    text-transform: uppercase; letter-spacing: .12em; font-size: 10px; white-space: nowrap;
  }
  .vswitch-sep { width: 1px; height: 20px; background: rgba(255, 255, 255, .14); flex: none; }
  @media (max-width: 680px) {
    .vswitch-label { display: none; }
    .vswitch-sep:first-of-type { display: none; }
    .vswitch a { padding: 0 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .vswitch, .vswitch a { transition-duration: .01ms !important; } }
</style>

<script>
  /* Tuck away while scrolling so it never fights the design being judged. */
  const bar = document.querySelector('.vswitch');
  if (bar) {
    let t, lastY = window.scrollY;
    addEventListener('scroll', () => {
      if (Math.abs(scrollY - lastY) < 6) return;
      lastY = scrollY;
      bar.dataset.tucked = 'true';
      clearTimeout(t);
      t = setTimeout(() => { bar.dataset.tucked = 'false'; }, 900);
    }, { passive: true });

    /* V flips to the same page in the other build. */
    addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const el = e.target;
      if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) return;
      if (e.key.toLowerCase() === 'v') {
        const other = bar.querySelector('a:not([aria-current]):not([href="/"])');
        if (other) location.href = other.getAttribute('href');
      }
    });
  }
</script>
